{
  "name": "socket-controller-rdy",
  "scripts": {
    "build": "rm -rf ./build ./dist && ./node_modules/typescript/bin/tsc",
    "dist": "rm -rf ./dist ./build && ./node_modules/typescript/bin/tsc --declaration --outDir ./dist && cp README.md package.json dist",
    "test:server": "node build/examples/barebone_server.js",
    "test:manager": "node build/examples/manager_server.js",
    "test:client": "node build/examples/cross-talks.js",
    "test:ack-client": "node build/examples/ack_client.js",
    "test:error-client": "node build/examples/error_cases.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@types/uuid": "^9.0.7",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1"
  },
  "version": "2.0.2"
}
